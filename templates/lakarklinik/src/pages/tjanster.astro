---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    id: '01',
    name: 'Allmänläkare',
    tag: 'Mest bokad',
    price: 'fr 250 kr',
    short: 'Akuta och planerade besök hos erfaren allmänläkare.',
    desc: 'Oavsett om du har akuta besvär, vill ha en andra åsikt eller behöver hjälp med en kronisk sjukdom — vi finns här. Vi hanterar allt från förkylningar och infektioner till remisser, sjukskrivningar och långvariga tillstånd.',
    included: ['Läkarsamtal upp till 30 min', 'Receptförskrivning', 'Remisser vid behov', 'Sjukintyg och intyg', 'Digital uppföljning ingår'],
  },
  {
    id: '02',
    name: 'Hälsoundersökning',
    tag: 'Förebyggande',
    price: 'fr 1 500 kr',
    short: 'Komplett hälsokontroll med blodprov, EKG och läkarbedömning.',
    desc: 'En noggrann genomgång av din hälsa. Resultaten tolkas av läkare och presenteras med konkreta råd om livsstil, kost och eventuell uppföljning. Perfekt som del av friskvård på jobbet eller för en personlig hälsoöversikt.',
    included: ['Utökat blodprov (30+ parametrar)', 'EKG och blodtrycksmätning', 'BMI och kroppskomposition', 'Läkarbedömning och genomgång', 'Skriftlig hälsorapport'],
  },
  {
    id: '03',
    name: 'Psykologi & KBT',
    tag: null,
    price: '1 200 kr / session',
    short: 'Samtalsterapi och KBT hos legitimerad psykolog.',
    desc: 'Stress, ångest, utmattning, relationsproblem eller livskriser — våra psykologer möter dig där du är. Vi arbetar framför allt med kognitiv beteendeterapi (KBT) som är en av de mest evidensbaserade metoderna för förändring.',
    included: ['50 min terapisession', 'Individuellt anpassad behandlingsplan', 'Hemuppgifter och verktyg', 'Uppföljning mellan sessioner', 'Remiss för specialistvård vid behov'],
  },
  {
    id: '04',
    name: 'Dermatologi',
    tag: null,
    price: '800 kr / besök',
    short: 'Medicinsk hudvård och bedömning av hudförändringar.',
    desc: 'Orolig för en hudförändring? Vi bedömer, diagnostiserar och behandlar ett brett spektrum av hudproblem — från eksem och akne till misstänkta pigmentförändringar. Vid behov remitteras till hudspecialist.',
    included: ['Klinisk undersökning av hud', 'Bedömning av hudförändringar', 'Behandlingsplan och råd', 'Receptförskrivning', 'Remiss till hudklinik vid behov'],
  },
  {
    id: '05',
    name: 'Vaccinationer',
    tag: null,
    price: 'fr 250 kr',
    short: 'Resevaccin, influensa och övriga rekommenderade vaccin.',
    desc: 'Planerar du en resa eller vill skydda dig inför influensasäsongen? Våra sjuksköterskor administrerar de flesta vanliga vacciner och ger rådgivning om vad som är lämpligt baserat på destination och hälsostatus.',
    included: ['Rådgivning om lämpliga vaccin', 'Influensavaccin', 'Resevaccin (TBE, hepatit, etc.)', 'Vaccinationsbevis', 'Digital dokumentation i journal'],
  },
  {
    id: '06',
    name: 'Digital konsultation',
    tag: 'Nytt',
    price: '350 kr / besök',
    short: 'Träffa din läkare via video — var du än befinner dig.',
    desc: 'Behöver du läkarvård men har inte möjlighet att ta dig till mottagningen? Boka en videokonsultation och träffa en av våra läkare direkt i telefonen eller datorn. Passar utmärkt för uppföljning, receptförnyelse och enklare besvär.',
    included: ['Videosamtal upp till 20 min', 'Receptförskrivning digitalt', 'Remisser vid behov', 'Tillgängligt kvällar och helger', 'Journalföring som vanligt besök'],
  },
  {
    id: '07',
    name: 'Sportmedicin',
    tag: null,
    price: '900 kr / besök',
    short: 'Skadeutredning, rehabilitering och prestationsoptimering.',
    desc: 'Oavsett om du är aktiv motionär eller tävlingsidrättare — vår sportmedicinska läkare kan hjälpa dig med allt från akuta skador till förebyggande träningsplanering och återhämtning.',
    included: ['Skadeutredning och diagnos', 'Funktionell rörelseanalys', 'Rehabiliteringsplan', 'Samarbete med fysioterapeut', 'Kortisoninjektion vid behov'],
  },
  {
    id: '08',
    name: 'Företagshälsovård',
    tag: 'Företag',
    price: 'Offert',
    short: 'Hälsoavtal och förebyggande insatser för ditt team.',
    desc: 'Vi erbjuder skräddarsydda hälsoavtal för företag och organisationer. Ditt team får tillgång till snabb vård, hälsokontroller och friskvårdsrådgivning — vilket minskar sjukfrånvaro och ökar välmående på jobbet.',
    included: ['Direktbokning utan kö', 'Hälsoundersökningar för personal', 'Ergonomianalys och råd', 'Krisstöd och psykologinsats', 'Månadsvis faktureringsoption'],
  },
];
---

<Layout title="Tjänster" description="Norrmalms Läkarkliniks tjänster: allmänläkare, hälsoundersökning, psykologi, dermatologi, vaccinationer och digital konsultation.">

  <!-- ─── PAGE HERO ─── -->
  <div class="page-hero">
    <div class="page-hero-bg"></div>
    <div class="page-hero-inner">
      <span class="page-hero-eyebrow">Tjänster & priser</span>
      <h1>Vad vi kan<br>hjälpa dig med</h1>
      <p>Från akuta besvär till förebyggande vård — allt på ett ställe, utan långa väntetider.</p>
    </div>
  </div>

  <!-- ─── SERVICES DETAIL ─── -->
  <section class="services-detail">
    {services.map((s, i) => (
      <article class={`svc-block ${i % 2 === 1 ? 'alt' : ''}`}>
        <div class="svc-block-inner">
          <div class="svc-block-left reveal">
            <div class="svc-block-meta">
              <span class="svc-block-num">{s.id}</span>
              {s.tag && <span class="svc-block-tag">{s.tag}</span>}
            </div>
            <h2 class="svc-block-name">{s.name}</h2>
            <p class="svc-block-short">{s.short}</p>
            <p class="svc-block-desc">{s.desc}</p>
            <div class="svc-block-price-row">
              <span class="svc-block-price">{s.price}</span>
              <a href="/boka" class="btn-primary">Boka →</a>
            </div>
          </div>
          <div class="svc-block-right reveal d2">
            <div class="svc-included-box">
              <div class="sib-title">Ingår i besöket</div>
              <ul class="sib-list">
                {s.included.map(item => (
                  <li>
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                      <path d="M2.5 7.5l3 3 6-6" stroke="var(--teal)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </article>
    ))}
  </section>

  <!-- ─── FAQ ─── -->
  <section class="faq-section">
    <div class="container">
      <div class="faq-header reveal">
        <span class="label">Vanliga frågor</span>
        <h2 class="faq-title">Bra att veta</h2>
      </div>
      <div class="faq-grid">
        <div class="faq-item reveal">
          <div class="faq-q">Behöver jag remiss för att besöka er?</div>
          <p class="faq-a">Nej, som privatklinik tar vi emot patienter utan remiss. Du bokar direkt hos oss och väljer vilken tjänst du vill ha.</p>
        </div>
        <div class="faq-item reveal d1">
          <div class="faq-q">Hur snabbt kan jag få tid?</div>
          <p class="faq-a">I de flesta fall erbjuder vi tid samma dag eller dagen efter. Akuta besvär prioriteras alltid.</p>
        </div>
        <div class="faq-item reveal d2">
          <div class="faq-q">Ingår besöken i högkostnadsskyddet?</div>
          <p class="faq-a">Privata besök ingår inte i landstingets högkostnadsskydd. Däremot är din hälsa en investering — och vi håller våra priser konkurrenskraftiga.</p>
        </div>
        <div class="faq-item reveal d3">
          <div class="faq-q">Kan jag använda sjukvårdsförsäkring?</div>
          <p class="faq-a">Ja. Vi samarbetar med de flesta stora försäkringsbolag. Kontakta oss så hjälper vi dig att kolla täckning.</p>
        </div>
        <div class="faq-item reveal">
          <div class="faq-q">Hur hanterar ni min journal?</div>
          <p class="faq-a">Vi är GDPR-certifierade och hanterar all patientdata säkert enligt patientdatalagen. Du har alltid rätt att se din journal.</p>
        </div>
        <div class="faq-item reveal d1">
          <div class="faq-q">Kan jag få recept digitalt?</div>
          <p class="faq-a">Ja, recept skickas direkt till Apoteket digitalt. Gäller för både fysiska besök och digitala konsultationer.</p>
        </div>
      </div>
      <div class="faq-cta reveal">
        <p>Har du andra frågor?</p>
        <a href="/boka" class="btn-primary">Boka ett besök →</a>
        <a href="tel:0812345678" class="btn-secondary">Ring oss</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .services-detail { background: var(--white); }
  .svc-block { border-bottom: 1px solid var(--subtle2); }
  .svc-block.alt { background: var(--bg); }
  .svc-block-inner {
    max-width: 1200px; margin: 0 auto;
    padding: clamp(3.5rem,7vw,6rem) clamp(1.5rem,5vw,4rem);
    display: grid; grid-template-columns: 1fr 360px;
    gap: clamp(3rem,6vw,7rem); align-items: start;
  }
  .svc-block-meta { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .svc-block-num {
    font-size: 0.62rem; letter-spacing: 0.2em; color: rgba(20,119,110,0.5);
  }
  .svc-block-tag {
    font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--teal); background: var(--teal-ll); padding: 0.2rem 0.65rem;
  }
  .svc-block-name {
    font-size: clamp(1.5rem,2.8vw,2rem);
    font-weight: 400; color: var(--navy);
    margin-bottom: 0.85rem; line-height: 1.15;
  }
  .svc-block-short {
    font-size: 0.95rem; font-weight: 500; color: var(--text);
    margin-bottom: 0.75rem; line-height: 1.6;
  }
  .svc-block-desc { font-size: 0.88rem; color: var(--muted); line-height: 1.85; margin-bottom: 2rem; }
  .svc-block-price-row {
    display: flex; align-items: center; gap: 1.5rem;
    padding-top: 1.5rem; border-top: 1px solid var(--subtle2); flex-wrap: wrap;
  }
  .svc-block-price {
    font-family: var(--font-display);
    font-size: 1.25rem; color: var(--navy); font-weight: 400;
  }
  .svc-included-box {
    background: var(--navy); padding: 2rem;
    position: sticky; top: calc(var(--nav-h) + 2rem);
  }
  .sib-title {
    font-size: 0.6rem; letter-spacing: 0.28em; text-transform: uppercase;
    color: rgba(255,255,255,0.4); margin-bottom: 1.25rem;
  }
  .sib-list { list-style: none; display: flex; flex-direction: column; gap: 0.85rem; }
  .sib-list li {
    display: flex; align-items: center; gap: 0.75rem;
    font-size: 0.85rem; color: rgba(255,255,255,0.75);
  }
  .sib-list li svg { flex-shrink: 0; }

  .faq-section { padding: clamp(5rem,10vw,8rem) 0; }
  .faq-header { margin-bottom: 3rem; }
  .faq-title { font-size: clamp(1.6rem,3vw,2.25rem); font-weight: 400; color: var(--navy); margin-top: 0.5rem; }
  .faq-grid {
    display: grid; grid-template-columns: repeat(2,1fr);
    gap: 0; border-top: 1px solid var(--subtle); border-left: 1px solid var(--subtle);
  }
  .faq-item {
    padding: 2rem 2.25rem;
    border-bottom: 1px solid var(--subtle); border-right: 1px solid var(--subtle);
    transition: background 0.25s;
  }
  .faq-item:hover { background: var(--white); }
  .faq-q { font-size: 0.92rem; font-weight: 600; color: var(--navy); margin-bottom: 0.6rem; }
  .faq-a { font-size: 0.85rem; color: var(--muted); line-height: 1.75; }
  .faq-cta {
    display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;
    margin-top: 3rem; padding-top: 2.5rem; border-top: 1px solid var(--subtle);
  }
  .faq-cta p { font-size: 0.88rem; color: var(--muted); }

  @media (max-width: 900px) {
    .svc-block-inner { grid-template-columns: 1fr; }
    .svc-included-box { position: static; }
    .faq-grid { grid-template-columns: 1fr; }
  }
</style>
