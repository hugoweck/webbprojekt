---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hem" description="Norrmalms Läkarklinik — Privat sjukvård i Stockholm. Korta väntetider, erfarna läkare, bokningsbar online.">

  <!-- ─── HERO ─── -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-vline"></div>

    <div class="hero-inner">
      <div class="hero-top reveal">
        <span class="hero-eyebrow">Privat sjukvård · Stockholm · Sedan 2009</span>
      </div>

      <div class="hero-center">
        <h1 class="hero-title reveal d1">
          Vård som tar<br>
          <em>sig tid</em> för<br>
          just dig.
        </h1>
        <div class="hero-desc reveal d2">
          <p>Modern privatklinik på Kungsgatan. Erfarna specialister, korta väntetider och ett personligt bemötande som gör skillnad.</p>
          <div class="hero-actions">
            <a href="/boka" class="btn-primary">Boka tid online →</a>
            <a href="/tjanster" class="hero-link">Tjänster & priser</a>
          </div>
        </div>
      </div>

      <div class="hero-bottom reveal d3">
        <div class="hero-stat">
          <span class="hs-num">1 500+</span>
          <span class="hs-lbl">nöjda patienter</span>
        </div>
        <div class="hero-rule"></div>
        <div class="hero-stat">
          <span class="hs-num">Samma dag</span>
          <span class="hs-lbl">väntetid i de flesta fall</span>
        </div>
        <div class="hero-rule"></div>
        <div class="hero-stat">
          <span class="hs-num">4 specialister</span>
          <span class="hs-lbl">under ett tak</span>
        </div>
        <div class="hero-rule"></div>
        <div class="hero-stat">
          <span class="hs-num">IVO-auktoriserad</span>
          <span class="hs-lbl">certifierad klinik</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SERVICES LIST ─── -->
  <section class="svc-section">
    <div class="container">
      <div class="svc-header reveal">
        <div>
          <span class="label">Våra tjänster</span>
          <h2 class="svc-title">Vad vi erbjuder</h2>
        </div>
        <a href="/tjanster" class="svc-all-link">Se alla tjänster och priser →</a>
      </div>

      <div class="svc-list">
        <a href="/tjanster" class="svc-row reveal">
          <span class="svc-num">01</span>
          <div class="svc-info">
            <strong>Allmänläkare</strong>
            <span>Akuta och planerade besök, remisser, kronisk sjukdom</span>
          </div>
          <div class="svc-meta">
            <span class="svc-tag">Mest bokad</span>
            <span class="svc-price">fr 250 kr</span>
          </div>
          <span class="svc-arrow">→</span>
        </a>
        <a href="/tjanster" class="svc-row reveal d1">
          <span class="svc-num">02</span>
          <div class="svc-info">
            <strong>Hälsoundersökning</strong>
            <span>Komplett kontroll med blodprov, EKG och läkarbedömning</span>
          </div>
          <div class="svc-meta">
            <span class="svc-tag">Förebyggande</span>
            <span class="svc-price">fr 1 500 kr</span>
          </div>
          <span class="svc-arrow">→</span>
        </a>
        <a href="/tjanster" class="svc-row reveal d2">
          <span class="svc-num">03</span>
          <div class="svc-info">
            <strong>Psykologi & KBT</strong>
            <span>Samtalsterapi och stresshantering hos legitimerad psykolog</span>
          </div>
          <div class="svc-meta">
            <span class="svc-price">1 200 kr / session</span>
          </div>
          <span class="svc-arrow">→</span>
        </a>
        <a href="/tjanster" class="svc-row reveal d3">
          <span class="svc-num">04</span>
          <div class="svc-info">
            <strong>Dermatologi</strong>
            <span>Hudförändringar, eksem, akne och medicinsk hudvård</span>
          </div>
          <div class="svc-meta">
            <span class="svc-price">800 kr / besök</span>
          </div>
          <span class="svc-arrow">→</span>
        </a>
        <a href="/tjanster" class="svc-row reveal d4">
          <span class="svc-num">05</span>
          <div class="svc-info">
            <strong>Vaccinationer</strong>
            <span>Resevaccin, influensa och övriga rekommenderade vaccin</span>
          </div>
          <div class="svc-meta">
            <span class="svc-price">fr 250 kr</span>
          </div>
          <span class="svc-arrow">→</span>
        </a>
        <a href="/tjanster" class="svc-row reveal d5">
          <span class="svc-num">06</span>
          <div class="svc-info">
            <strong>Digital konsultation</strong>
            <span>Videoläkare — träffa din doktor var du än befinner dig</span>
          </div>
          <div class="svc-meta">
            <span class="svc-tag">Nytt</span>
            <span class="svc-price">350 kr / besök</span>
          </div>
          <span class="svc-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── ABOUT ─── -->
  <section class="about">
    <div class="about-visual">
      <div class="about-visual-inner">
        <blockquote class="about-quote">
          "Privat sjukvård ska vara tillgänglig — inte ett privilegium för de få."
        </blockquote>
        <div class="about-quote-attr">— Dr. Anna Lindgren, grundare</div>
      </div>
      <div class="about-stat-row">
        <div class="about-stat">
          <div class="as-num">2009</div>
          <div class="as-lbl">grundades kliniken</div>
        </div>
        <div class="about-stat">
          <div class="as-num">15+</div>
          <div class="as-lbl">år i branschen</div>
        </div>
      </div>
    </div>
    <div class="about-body">
      <span class="label reveal">Om kliniken</span>
      <h2 class="about-h2 reveal d1">En klinik byggd<br>på <em>förtroende</em></h2>
      <p class="about-p reveal d2">Norrmalms Läkarklinik grundades med övertygelsen att privat sjukvård ska hålla hög standard utan att vara otillgänglig. Vi har byggt en mottagning där varje patient möts med tid, respekt och klinisk kompetens.</p>
      <p class="about-p reveal d3">Idag har vi fyra specialister under ett tak, moderna lokaler mitt i Stockholm och ett nära samarbete med Karolinska för de fall som kräver ytterligare utredning.</p>
      <div class="about-checks reveal d4">
        <div class="ac-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="var(--teal)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Tid samma dag i de flesta fall</span>
        </div>
        <div class="ac-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="var(--teal)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Erfarna specialister med bred kompetens</span>
        </div>
        <div class="ac-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="var(--teal)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>IVO-auktoriserad och GDPR-certifierad</span>
        </div>
        <div class="ac-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="var(--teal)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Digital konsultation tillgänglig dygnet runt</span>
        </div>
      </div>
      <a href="/om-oss" class="btn-secondary reveal d5">Lär känna teamet →</a>
    </div>
  </section>

  <!-- ─── TESTIMONIAL ─── -->
  <section class="testimonial-section">
    <div class="container">
      <div class="t-featured reveal">
        <div class="t-mark">"</div>
        <blockquote class="t-quote">
          Äntligen en klinik som verkligen tar sig tid. Dr Lindgren lyssnade ordentligt, tog mina besvär på allvar och jag fick tid samma dag. Kände mig sedd som människa — inte som ett journalnummer.
        </blockquote>
        <div class="t-attr">
          <div class="t-av">AK</div>
          <div>
            <div class="t-name">Anna Karlsson</div>
            <div class="t-since">Patient sedan 2021 · ★★★★★</div>
          </div>
        </div>
      </div>
      <div class="t-mini-row">
        <div class="t-mini reveal d1">
          <p>"Hälsoundersökningen var grundlig och välorganiserad. Fick alla resultat med tydliga förklaringar — inget flum, inga oklarheter."</p>
          <div class="tm-attr">
            <span class="tm-name">Lars Magnusson</span>
            <span class="tm-role">Hälsoundersökning, 2023</span>
          </div>
        </div>
        <div class="t-mini reveal d2">
          <p>"KBT-terapin med Dr Bergström var livsförändrande. Strukturerad, varm och med tydliga verktyg som faktiskt fungerar i vardagen."</p>
          <div class="tm-attr">
            <span class="tm-name">Emma Hedlund</span>
            <span class="tm-role">KBT-terapi, 2024</span>
          </div>
        </div>
        <div class="t-mini reveal d3">
          <p>"Bokade dermatologtid och fick hjälp inom 24 timmar. Professionell bedömning utan onödig väntan. Rekommenderar varmt."</p>
          <div class="tm-attr">
            <span class="tm-name">Johan Ström</span>
            <span class="tm-role">Dermatologi, 2024</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CTA ─── -->
  <section class="cta-section">
    <div class="cta-inner reveal">
      <span class="label" style="color:rgba(255,255,255,0.5)">Boka din tid</span>
      <h2 class="cta-title">Redo att ta hand<br>om din hälsa?</h2>
      <div class="cta-btns">
        <a href="/boka" class="btn-cta-light">Boka online →</a>
        <a href="tel:0812345678" class="btn-cta-ghost">08 – 123 456 78</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ─── HERO ─── */
  .hero {
    position: relative; min-height: 100dvh;
    background: var(--navy);
    display: flex; flex-direction: column;
    overflow: hidden;
    padding: 0 clamp(1.5rem,5vw,4rem);
  }
  .hero-bg {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 55% 65% at 85% 20%, rgba(20,119,110,0.12) 0%, transparent 55%),
      radial-gradient(ellipse 45% 55% at 5% 85%, rgba(20,119,110,0.06) 0%, transparent 50%);
  }
  .hero-vline {
    position: absolute; top: 0; bottom: 0; left: clamp(1.5rem,5vw,4rem);
    width: 1px;
    background: linear-gradient(to bottom,
      transparent 5%,
      rgba(20,119,110,0.25) 15%,
      rgba(20,119,110,0.25) 85%,
      transparent 95%);
  }
  .hero-inner {
    position: relative; z-index: 1;
    display: flex; flex-direction: column; justify-content: space-between;
    min-height: 100dvh;
    padding-left: clamp(1.5rem,4vw,3rem);
    padding-top: calc(var(--nav-h) + clamp(3rem,7vh,5rem));
    padding-bottom: clamp(2.5rem,5vh,4rem);
  }
  .hero-eyebrow {
    font-size: 0.62rem; letter-spacing: 0.3em; text-transform: uppercase;
    color: rgba(20,119,110,0.8); display: block;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3rem,7vw,6rem);
    font-weight: 400; color: #fff;
    line-height: 1.06; letter-spacing: -0.02em;
    margin: clamp(2rem,5vh,4rem) 0 2rem;
    max-width: 680px;
  }
  .hero-title em {
    font-style: italic; color: rgba(255,255,255,0.45);
  }
  .hero-desc p {
    font-size: clamp(0.9rem,1.5vw,1rem);
    color: rgba(255,255,255,0.45); max-width: 440px;
    line-height: 1.85; margin-bottom: 2rem;
  }
  .hero-actions { display: flex; align-items: center; gap: 1.75rem; flex-wrap: wrap; }
  .hero-link {
    font-size: 0.82rem; color: rgba(255,255,255,0.45); text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,0.15);
    padding-bottom: 1px;
    transition: color 0.25s, border-color 0.25s;
  }
  .hero-link:hover { color: rgba(255,255,255,0.75); border-color: rgba(255,255,255,0.4); }

  .hero-bottom {
    display: flex; align-items: center; gap: 2rem;
    flex-wrap: wrap; padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.07);
  }
  .hero-rule { width: 1px; height: 28px; background: rgba(255,255,255,0.12); flex-shrink: 0; }
  .hero-stat { display: flex; flex-direction: column; gap: 0.2rem; }
  .hs-num { font-size: 0.88rem; font-weight: 500; color: #fff; }
  .hs-lbl { font-size: 0.65rem; letter-spacing: 0.05em; color: rgba(255,255,255,0.3); }

  /* ─── SERVICES LIST ─── */
  .svc-section { padding: clamp(6rem,12vw,10rem) 0; }
  .svc-header {
    display: flex; align-items: flex-end; justify-content: space-between;
    margin-bottom: 3rem; flex-wrap: wrap; gap: 1rem;
  }
  .svc-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem,3vw,2.25rem);
    font-weight: 400; color: var(--navy); margin-top: 0.5rem;
  }
  .svc-all-link {
    font-size: 0.8rem; color: var(--teal); text-decoration: none;
    border-bottom: 1px solid rgba(20,119,110,0.3); padding-bottom: 1px;
    white-space: nowrap; align-self: flex-end;
    transition: border-color 0.25s;
  }
  .svc-all-link:hover { border-color: var(--teal); }
  .svc-list { border-top: 1px solid var(--subtle); }
  .svc-row {
    display: grid;
    grid-template-columns: 3rem 1fr auto 1.5rem;
    align-items: center; gap: 1.5rem;
    padding: 1.5rem 0; text-decoration: none; color: inherit;
    border-bottom: 1px solid var(--subtle);
    transition: background 0.2s; cursor: pointer;
  }
  .svc-row:hover { background: var(--white); padding-left: 1rem; padding-right: 1rem; margin: 0 -1rem; }
  .svc-num {
    font-size: 0.65rem; letter-spacing: 0.12em;
    color: rgba(20,119,110,0.5); font-variant-numeric: tabular-nums;
    align-self: start; padding-top: 0.15rem;
  }
  .svc-info { display: flex; flex-direction: column; gap: 0.3rem; }
  .svc-info strong { font-size: 1rem; font-weight: 500; color: var(--navy); }
  .svc-info span { font-size: 0.82rem; color: var(--muted); }
  .svc-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 0.3rem; }
  .svc-tag {
    font-size: 0.6rem; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--teal); background: var(--teal-ll);
    padding: 0.2rem 0.6rem;
  }
  .svc-price { font-size: 0.88rem; font-weight: 500; color: var(--navy); white-space: nowrap; }
  .svc-arrow {
    color: rgba(20,119,110,0.35); font-size: 0.9rem;
    transition: color 0.25s, transform 0.25s;
  }
  .svc-row:hover .svc-arrow { color: var(--teal); transform: translateX(3px); }

  /* ─── ABOUT ─── */
  .about {
    display: grid; grid-template-columns: 1fr 1fr;
    min-height: 640px;
  }
  .about-visual {
    background: var(--navy);
    padding: clamp(4rem,8vw,7rem) clamp(2rem,5vw,5rem);
    display: flex; flex-direction: column; justify-content: space-between;
    position: relative; overflow: hidden;
  }
  .about-visual::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 70% 60% at 30% 40%, rgba(20,119,110,0.12) 0%, transparent 60%);
  }
  .about-visual-inner { position: relative; z-index: 1; }
  .about-quote {
    font-family: var(--font-display);
    font-size: clamp(1.3rem,2.5vw,1.75rem);
    font-style: italic; font-weight: 400;
    color: #fff; line-height: 1.45;
    border-left: 2px solid var(--teal);
    padding-left: 1.5rem; margin-bottom: 1.25rem;
  }
  .about-quote-attr {
    font-size: 0.72rem; letter-spacing: 0.08em;
    color: rgba(255,255,255,0.35); padding-left: 1.5rem;
  }
  .about-stat-row {
    position: relative; z-index: 1;
    display: flex; gap: 3rem; padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  .as-num {
    font-family: var(--font-display);
    font-size: 1.75rem; font-weight: 400; color: #fff; line-height: 1;
  }
  .as-lbl { font-size: 0.68rem; color: rgba(255,255,255,0.3); margin-top: 0.3rem; }
  .about-body {
    background: var(--white);
    padding: clamp(4rem,8vw,7rem) clamp(2.5rem,5vw,5rem);
    display: flex; flex-direction: column; justify-content: center; gap: 0;
  }
  .about-h2 {
    font-size: clamp(1.8rem,3.5vw,2.5rem);
    font-weight: 400; color: var(--navy);
    line-height: 1.15; margin: 0.75rem 0 1.5rem;
  }
  .about-h2 em { font-style: italic; color: var(--teal); }
  .about-p { font-size: 0.9rem; color: var(--muted); line-height: 1.85; margin-bottom: 0.85rem; }
  .about-checks { display: flex; flex-direction: column; gap: 0.7rem; margin: 1.5rem 0 2rem; }
  .ac-item { display: flex; align-items: center; gap: 0.75rem; font-size: 0.85rem; color: var(--text); }

  /* ─── TESTIMONIALS ─── */
  .testimonial-section { padding: clamp(5rem,10vw,9rem) 0; }
  .t-featured {
    background: var(--white); padding: clamp(2.5rem,5vw,4rem);
    border-left: 3px solid var(--teal);
    position: relative; margin-bottom: 1.5rem;
  }
  .t-mark {
    font-family: var(--font-display);
    font-size: 6rem; line-height: 0.5;
    color: rgba(20,119,110,0.1); margin-bottom: 1rem;
    font-style: italic;
  }
  .t-quote {
    font-family: var(--font-display);
    font-size: clamp(1.1rem,2.5vw,1.5rem);
    font-style: italic; font-weight: 400;
    color: var(--navy); line-height: 1.6;
    max-width: 820px; margin-bottom: 2rem;
  }
  .t-attr { display: flex; align-items: center; gap: 1rem; }
  .t-av {
    width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0;
    background: var(--teal-l); display: flex; align-items: center;
    justify-content: center; font-size: 0.75rem; font-weight: 600; color: var(--teal);
  }
  .t-name { font-size: 0.88rem; font-weight: 500; color: var(--navy); }
  .t-since { font-size: 0.7rem; color: var(--muted); margin-top: 0.1rem; }

  .t-mini-row { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: var(--subtle2); }
  .t-mini {
    background: var(--white);
    padding: 2rem; display: flex; flex-direction: column; justify-content: space-between;
  }
  .t-mini p {
    font-size: 0.88rem; color: var(--muted); line-height: 1.75;
    font-style: italic; margin-bottom: 1.25rem; flex: 1;
  }
  .tm-attr { display: flex; flex-direction: column; gap: 0.15rem; }
  .tm-name { font-size: 0.82rem; font-weight: 500; color: var(--navy); }
  .tm-role { font-size: 0.7rem; color: var(--muted); }

  /* ─── CTA ─── */
  .cta-section {
    background: var(--navy); padding: clamp(5rem,10vw,8rem) 0;
    position: relative; overflow: hidden;
    text-align: center;
  }
  .cta-section::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 70% 100% at 50% 50%, rgba(20,119,110,0.12) 0%, transparent 65%);
  }
  .cta-inner { position: relative; z-index: 1; }
  .cta-title {
    font-family: var(--font-display);
    font-size: clamp(2rem,5vw,3.5rem);
    font-weight: 400; color: #fff;
    line-height: 1.1; margin: 0.75rem 0 2.5rem;
  }
  .cta-btns { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-cta-light {
    display: inline-flex; padding: 1rem 2.5rem;
    background: #fff; color: var(--navy);
    font-size: 0.85rem; font-weight: 500; text-decoration: none;
    transition: background 0.25s;
  }
  .btn-cta-light:hover { background: var(--teal-l); }
  .btn-cta-ghost {
    display: inline-flex; padding: 1rem 2.5rem;
    border: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.7);
    font-size: 0.85rem; text-decoration: none;
    transition: border-color 0.25s, color 0.25s;
  }
  .btn-cta-ghost:hover { border-color: rgba(255,255,255,0.55); color: #fff; }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 960px) {
    .svc-row { grid-template-columns: 2.5rem 1fr 1.5rem; }
    .svc-meta { display: none; }
    .about { grid-template-columns: 1fr; }
    .about-visual { min-height: 380px; }
    .t-mini-row { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .hero-bottom { gap: 1.25rem; }
    .hero-rule { display: none; }
    .svc-row { grid-template-columns: 2rem 1fr 1rem; gap: 0.75rem; }
    .hero-vline { display: none; }
  }
</style>
